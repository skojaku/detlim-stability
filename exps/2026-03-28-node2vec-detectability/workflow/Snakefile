# Standalone Snakemake workflow for exploration: node2vec-detectability
# Self-contained — not connected to the project's main Snakefile.
# Run from this directory: snakemake -c<N> [target]

from os.path import join as j

include: "./utils.smk"

# === Config ===
DATA_DIR = "../data"    # exps/2026-03-28-node2vec-detectability/data/

# === Dataset parameters ===
NET_PARAMS = {
    "n":    [2000],
    "cave": [5.0],
    "mu":   [0.3, 0.35, 0.4, 0.45, 0.5, 0.52],
}
N_SAMPLES = 30
SAMPLE_IDS = [f"{s:03d}" for s in range(N_SAMPLES)]
DIM = 64

net_paramspace = to_paramspace(NET_PARAMS)

# === File paths ===
NETWORK_FILE     = j(DATA_DIR, "networks",  net_paramspace.wildcard_pattern, "sample~{sample}.npz")
NMI_FILE_BP      = j(DATA_DIR, "baselines", "bp",       f"{net_paramspace.wildcard_pattern}_sample~{{sample}}.csv")
NMI_FILE_SPECTRAL= j(DATA_DIR, "baselines", "spectral", f"{net_paramspace.wildcard_pattern}_sample~{{sample}}.csv")
NMI_FILE_NODE2VEC= j(DATA_DIR, "baselines", "node2vec", f"{net_paramspace.wildcard_pattern}_sample~{{sample}}.csv")
NMI_FILE_N2VEC_MF= j(DATA_DIR, "baselines", "n2vec_mf", f"{net_paramspace.wildcard_pattern}_sample~{{sample}}.csv")
BASELINES_COMBINED = j(DATA_DIR, "baselines", "nmi_all.csv")
BASELINES_FIG      = j(DATA_DIR, "figs",      "nmi_vs_mu.png")

# === Includes ===
include: "rules/generate_networks.smk"
include: "rules/run_baselines.smk"

# === Parameters ===
# params_my_analysis = {
#     "param_a": [1, 2, 3],
#     "param_b": ["option_x"],
# }
# my_paramspace = to_paramspace(params_my_analysis)

# === File paths ===
